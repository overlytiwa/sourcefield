{
  "name": "sourcefield",
  "productName": "Sourcefield",
  "version": "1.2.0",
  "description": "Explore a local codebase as a luminous, symbol-level 3D map.",
  "private": true,
  "main": "dist-electron/main.cjs",
  "author": "Sourcefield contributors",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run icons && tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "check": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "install-cli": "npm link",
    "icons": "node scripts/build-icons.mjs",
    "mcp": "node dist-electron/mcp.cjs",
    "smoke:mcp": "node scripts/mcp-smoke.mjs",
    "smoke:dependencies": "node scripts/dependencies-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ignore": "^7.0.5",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.0",
    "tree-sitter-wasms": "^0.1.13",
    "typescript": "^5.9.3",
    "web-tree-sitter": "^0.25.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.0",
    "sharp": "^0.34.5",
    "vite": "^7.2.2"
  },
  "build": {
    "appId": "app.sourcefield.desktop",
    "productName": "Sourcefield",
    "directories": {
      "output": "release",
      "buildResources": "resources/icons"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "LICENSE",
      "resources/ICON-LICENSE.txt"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "sourcefield",
        "name": "Sourcefield code map",
        "role": "Editor",
        "mimeType": "application/x-sourcefield"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "resources/icons/icon.ico",
      "uninstallerIcon": "resources/icons/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "resources/icons/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "resources/icons/linux"
    },
    "executableName": "sourcefield",
    "asarUnpack": [
      "**/*.wasm",
      "dist-electron/python_analyzer.py"
    ],
    "extraResources": [
      {
        "from": "resources/icons",
        "to": "icons",
        "filter": [
          "icon.png",
          "icon.ico"
        ]
      },
      {
        "from": "dist-electron/mcp.cjs",
        "to": "mcp/sourcefield-mcp.cjs"
      }
    ]
  },
  "bin": {
    "sourcefield": "scripts/sourcefield.cjs"
  }
}
